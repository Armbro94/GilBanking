<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <!--
    Die SDK-Version bestimmt den Dalamud-API-Level (15.x = API 15).
    Bei neuen Dalamud-Versionen hier erhöhen (nuget.org/packages/Dalamud.NET.Sdk).
  -->
  <PropertyGroup>
    <Version>0.0.0.10</Version>
    <Description>Gil and sales tracker (read-only, no automation).</Description>
    <PackageProjectUrl>https://example.invalid/GilBanking</PackageProjectUrl>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Das Icon muss als images/icon.png im Plugin-Ordner liegen, damit Dalamud es bei installierten Plugins anzeigt. -->
  <ItemGroup>
    <Content Include="images\icon.png" Link="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
